# ---------- server ----------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Public URL of the deployment (used for share links). Railway injects RAILWAY_PUBLIC_DOMAIN.
BASE_URL=

# ---------- branding ----------
BRAND_NAME=WeTube
BRAND_TITLE_SUFFIX=YouTube
ASSET_VERSION=2.9.60

# ---------- sessions ----------
# REQUIRED in production: a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=wetube.sid
SESSION_MAX_AGE_DAYS=30

# ---------- youtube locale ----------
YT_HL=ja
YT_GL=JP

# ---------- proxy (the fix for data-centre IP blocks) ----------
# Any HTTP/HTTPS CONNECT proxy, e.g. http://user:pass@host:port
YT_PROXY=
# HTTPS_PROXY=

# ---------- stream url providers ----------
# awakest  = awakest.net YouTube tool (same upstream as the reference deployment)
# innertube= formats straight from YouTube's player response
# custom   = your own endpoint (see STREAM_API_URL)
STREAM_PROVIDER=awakest
STREAM_PROVIDER_ORDER=awakest,innertube,custom
AWAKEST_BASE=https://awakest.net
STREAM_TIMEOUT_MS=20000
# Invidious / Piped / any JSON-or-HTML endpoint. {id} is replaced with the video id.
# STREAM_API_URL=https://inv.example.net/api/v1/videos/{id}
STREAM_API_URL=
# Optional header value, e.g. "Bearer xyz"
STREAM_API_HEADER=

# ---------- discovery feed queries ----------
HOME_QUERY=人気動画
TRENDING_QUERY=急上昇
MUSIC_QUERY=音楽
GAMING_QUERY=ゲーム
NEWS_QUERY=ニュース
SHORTS_QUERIES=人気動画,急上昇,面白動画,ショート
HOME_CHIPS=アニメ,料理,プログラミング,旅行

# ---------- alternate embed players ----------
# comma separated base URLs; each gets /embed/<videoId> appended
EMBED_MIRRORS=

# ---------- cache ----------
CACHE_TTL_SECONDS=300
FEED_CACHE_TTL_SECONDS=180
VIDEO_CACHE_TTL_SECONDS=900
SUGGESTIONS_TTL_SECONDS=3600
MAX_CACHE_ENTRIES=4000

# ---------- image proxy ----------
IMAGE_PROXY_ALLOW_ANY_HOST=false
IMAGE_PROXY_MAX_BYTES=6291456

# ---------- oauth (auto-detected from youtube.com/tv; override if needed) ----------
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPE=https://www.googleapis.com/auth/youtube-third-party-link
OAUTH_POLL_INTERVAL_MS=5000

# ---------- features / limits ----------
ENABLE_LIVE_CHAT=true
ENABLE_DOWNLOADS=true
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# ---------- optional shared state for multiple replicas ----------
REDIS_URL=
